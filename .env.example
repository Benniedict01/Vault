DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/cryptovault?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/cryptovault?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="https://cryptovault.new.tg"
# Email: Resend over HTTPS (works on Render free plan)
RESEND_API_KEY=""
EMAIL_FROM="Crypto Vault <alerts@your-verified-domain.com>"
# Optional fallback if RESEND_API_KEY is empty (needs a host that allows outbound SMTP):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
CRON_SECRET="replace-with-another-long-random-secret"

# Solana RPC: use a dedicated Helius mainnet endpoint (free tier available).
# Create a Helius API key, then replace YOUR_HELIUS_API_KEY.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# Optional APIs for richer token discovery and higher market-data limits.
# Moralis enables indexed token discovery on supported EVM chains.
MORALIS_API_KEY=""
# CoinGecko Demo API key raises market-data rate limits.
COINGECKO_API_KEY=""
