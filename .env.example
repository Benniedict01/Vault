# ── Database ──────────────────────────────────────────────
# Render PostgreSQL connection string (use the External URL for local dev).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cryptovault?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# ── App ───────────────────────────────────────────────────
# Exact deployed URL, no trailing slash. Used in every email link.
APP_URL="http://localhost:3000"

# ── Email (HTTPS API — no SMTP on Render free tier) ───────
# Resend API key (https://resend.com/api-keys). Server-side only; never expose
# to client JavaScript and never commit the real value.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Sender must be on a domain verified in Resend.
EMAIL_FROM="Crypto Vault <alerts@your-verified-domain.com>"

# Optional email-provider failover (leave empty unless a second provider is
# actually configured). Primary defaults to "resend".
# EMAIL_PROVIDER="resend"
# EMAIL_PROVIDER_FALLBACK=""

# ── Monitoring scheduler ──────────────────────────────────
# Shared secret for the scheduled monitor job (GitHub Actions / Render Cron).
# Generate with: openssl rand -base64 48
CRON_SECRET="replace-with-another-long-random-secret"

# ── Optional tuning ───────────────────────────────────────
# Seconds to cache market prices (default 30).
# PRICE_CACHE_TTL_SECONDS="30"
