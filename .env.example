DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cryptovault?sslmode=require"
# Signs sessions and verification/reset tokens. 32+ random characters.
# Rotating it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
# Email: Plunk over HTTPS (works on Render free; there is no SMTP path at all).
# Create a key at https://useplunk.com and paste it here, or leave it empty and
# verification/reset emails will fail with a logged "not configured" error.
PLUNK_SECRET_KEY=""
# Optional sender. Must be a verified address in your Plunk project, either
# "alerts@your-domain.com" or "Crypto Vault <alerts@your-domain.com>".
# Leave empty to use the project's default sender.
PLUNK_FROM="Crypto Vault <alerts@your-verified-domain.com>"
CRON_SECRET="replace-with-another-long-random-secret"
