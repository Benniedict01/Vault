generator client {
  provider        = "prisma-client-js"
  // Engine-less client: the query engine ships as WASM inside @prisma/client
  // and queries run through the pg driver adapter (see lib/prisma.js), so
  // builds and deploys never download native engine binaries.
  engineType      = "client"
  previewFeatures = ["queryCompiler"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  emailVerifiedAt          DateTime?
  verificationTokenHash    String?
  verificationTokenExpiresAt DateTime?
  resetTokenHash           String?
  resetTokenExpiresAt      DateTime?
  tokenMonitoringEnabled   Boolean   @default(true)
  notifyDeposits           Boolean   @default(true)
  notifyWithdrawals        Boolean   @default(false)
  notifyTokenDeposits      Boolean   @default(true)
  minimumNotificationUsd   String    @default("0")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  wallets                  Wallet[]
  notifications            Notification[]
  emailEvents              EmailEvent[]
}

model Wallet {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  chain               String
  address             String
  lastNativeAmount    String    @default("0")
  lastNativeUsdValue  String    @default("0")
  lastCheckedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  notifications       Notification[]
  @@unique([userId, chain, address])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  walletId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain       String
  symbol      String
  amount      String
  usdValue    String?
  txHash      String?
  type        String    @default("deposit")
  createdAt   DateTime  @default(now())
  @@index([userId, createdAt])
}

// Delivery/observability log for transactional email. Stores provider metadata
// only — never email bodies, passwords, or verification/reset tokens.
model EmailEvent {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type              String
  provider          String
  providerMessageId String?
  status            String
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([userId, createdAt])
  @@index([type, status, createdAt])
}

// Idempotency ledger for monitor-detected on-chain events. `key` is a
// deterministic identifier (e.g. chain + txHash + wallet + asset); the unique
// constraint makes notification delivery exactly-once across monitor runs.
model ProcessedEvent {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String
  userId    String?
  walletId  String?
  createdAt DateTime @default(now())
  @@index([walletId, createdAt])
  @@index([userId, createdAt])
}
