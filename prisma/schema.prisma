generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  emailVerifiedAt          DateTime?
  verificationTokenHash    String?
  verificationTokenExpiresAt DateTime?
  resetTokenHash           String?
  resetTokenExpiresAt      DateTime?
  tokenMonitoringEnabled   Boolean   @default(true)
  notifyDeposits           Boolean   @default(true)
  notifyWithdrawals        Boolean   @default(false)
  notifyTokenDeposits      Boolean   @default(true)
  minimumNotificationUsd   String    @default("0")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  wallets                  Wallet[]
  notifications            Notification[]
}

model Wallet {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  chain               String
  address             String
  lastNativeAmount    String    @default("0")
  lastNativeUsdValue  String    @default("0")
  lastCheckedAt       DateTime?
  // Withdrawal confirmation (failsafe 5.3). lastConfirmedAmount is the last
  // balance an alert was decided against; it only moves once a change is
  // confirmed. A first balance drop is parked in pendingDecreaseAmount and is
  // alerted on only if the next read still shows the drop, so a provider that
  // briefly reports zero cannot raise a false withdrawal alert.
  lastConfirmedAmount   String?
  pendingDecreaseAmount String?
  pendingDecreaseAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  notifications       Notification[]
  @@unique([userId, chain, address])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  walletId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain       String
  symbol      String
  amount      String
  usdValue    String?
  txHash      String?
  type        String    @default("deposit")
  // Delivery state (failsafe 5.1). The row is always written before the email
  // is attempted, so an alert that could not be emailed is retried by a later
  // monitor run instead of being lost.
  // sentAt defaults to "now" so rows that existed before this column was added
  // are treated as already delivered: deploying this must not re-send the last
  // day of alerts. The alert pipeline sets sentAt to null explicitly when it
  // wants a retry.
  sentAt       DateTime? @default(now())
  sendAttempts Int       @default(0)
  sendError    String?
  createdAt   DateTime  @default(now())
  @@index([userId, createdAt])
  @@index([sentAt, createdAt])
}
